<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoodApp.Presentacion.Views.Usuarios.PaymentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:FoodApp.Domain.Entities"
    xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:FoodApp.Presentacion.Views.Usuarios"
    xmlns:vm="clr-namespace:FoodApp.Presentacion.ViewModels.Usuarios"
    x:Name="PaymentPageRoot"
    droid:NavigationBar.Color="White"
    droid:NavigationBar.Style="DarkContent"
    x:DataType="vm:PaymentViewModel"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="White" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!--  PANTALLA PRINCIPAL  -->
        <Grid
            x:Name="PaymentForm"
            IsVisible="{Binding IsPaymentViewVisible}"
            RowDefinitions="Auto, *, Auto">

            <!--  1. CABECERA  -->
            <Grid
                Grid.Row="0"
                Margin="24,16"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="18">
                <ImageButton
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    Command="{Binding GoBackCommand}"
                    CornerRadius="20"
                    HeightRequest="45"
                    Source="ic_back_white.svg"
                    WidthRequest="45" />
                <Label
                    Grid.Column="1"
                    FontFamily="SenRegular"
                    FontSize="18"
                    HorizontalOptions="Start"
                    Text="Payment"
                    TextColor="#181C2E"
                    VerticalOptions="Center" />
            </Grid>

            <!--  2. MÉTODOS DE PAGO Y TARJETA  -->
            <ScrollView Grid.Row="1" Margin="24,12,24,0">
                <VerticalStackLayout Spacing="16">

                    <!--  Opciones Superiores: Cash, Visa, Mastercard  -->
                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="12">

                            <!--  Filtro Cash  -->
                            <VerticalStackLayout Spacing="4">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FilterCardsCommand}" CommandParameter="Cash" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border
                                    BackgroundColor="#F0F5FA"
                                    HeightRequest="72"
                                    Stroke="Transparent"
                                    WidthRequest="85">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedBrandFilter}"
                                            TargetType="Border"
                                            Value="Cash">
                                            <Setter Property="Stroke" Value="#FF7622" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="24"
                                        Source="ic_cash.svg"
                                        WidthRequest="24" />
                                </Border>
                                <Label
                                    FontFamily="SenRegular"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="Cash"
                                    TextColor="#464E57" />
                            </VerticalStackLayout>

                            <!--  Filtro Visa  -->
                            <VerticalStackLayout Spacing="4">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FilterCardsCommand}" CommandParameter="Visa" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Border
                                    BackgroundColor="#F0F5FA"
                                    HeightRequest="72"
                                    Stroke="Transparent"
                                    WidthRequest="85">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedBrandFilter}"
                                            TargetType="Border"
                                            Value="Visa">
                                            <Setter Property="Stroke" Value="#FF7622" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        Source="ic_visa.svg"
                                        WidthRequest="30" />
                                </Border>
                                <Label
                                    FontFamily="SenRegular"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="Visa"
                                    TextColor="#464E57" />
                            </VerticalStackLayout>

                            <!--  Filtro Mastercard  -->
                            <VerticalStackLayout Spacing="4">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FilterCardsCommand}" CommandParameter="Mastercard" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border
                                    BackgroundColor="#F0F5FA"
                                    HeightRequest="72"
                                    Stroke="Transparent"
                                    WidthRequest="85">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedBrandFilter}"
                                            TargetType="Border"
                                            Value="Mastercard">
                                            <Setter Property="Stroke" Value="#FF7622" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        Source="ic_mastercard.svg"
                                        WidthRequest="30" />
                                </Border>
                                <Label
                                    FontFamily="SenRegular"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="Mastercard"
                                    TextColor="#464E57" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!--  ESTADO A: SI NO HAY TARJETA  -->
                    <VerticalStackLayout IsVisible="{Binding HasCard, Converter={StaticResource InvertedBoolConverter}}" Spacing="16">
                        <Border
                            Padding="24"
                            BackgroundColor="#F7F8F9"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="117"
                                    HorizontalOptions="Center"
                                    Source="ic_mastercard_card.svg" />
                                <Label
                                    FontFamily="SenBold"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="No card added"
                                    TextColor="#32343E" />
                                <Label
                                    FontFamily="SenRegular"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Text="You can add a card and save it for later"
                                    TextColor="#2D2D2D" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!--  ESTADO B: SI SÍ HAY TARJETA (Al hacer click abre el BottomSheet)  -->
                    <VerticalStackLayout IsVisible="{Binding HasCard}" Spacing="16">
                        <Border
                            Padding="20"
                            BackgroundColor="#F4F5F7"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenBottomSheetCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="10">
                                    <Label
                                        FontFamily="SenBold"
                                        FontSize="16"
                                        Text="{Binding SavedCard.Brand, StringFormat='{0} Card'}"
                                        TextColor="#32343E"
                                        VerticalOptions="Center" />
                                    <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="2">
                                        <Label
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            FontAttributes="Bold"
                                            Text="{Binding SavedCard.Brand}"
                                            TextColor="Orange"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="SenRegular"
                                            FontSize="16"
                                            HorizontalOptions="Start"
                                            Text="{Binding SavedCard.CardNumberMasked, StringFormat='************ {0}'}"
                                            TextColor="#32343E"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    FontSize="16"
                                    HorizontalOptions="End"
                                    Text="▼"
                                    TextColor="#181C2E"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!--  Botón Add New (Envía el tipo de tarjeta seleccionado por defecto)  -->
                    <Button
                        BackgroundColor="White"
                        BorderColor="#F0F5FA"
                        BorderWidth="2"
                        Command="{Binding NavigateToAddCardCommand}"
                        CornerRadius="12"
                        FontFamily="SenBold"
                        FontSize="14"
                        HeightRequest="62"
                        Text="+ ADD NEW"
                        TextColor="#FF7622" />
                </VerticalStackLayout>
            </ScrollView>

            <!--  3. PANEL INFERIOR DE PAGO  -->
            <Border
                Grid.Row="2"
                Padding="24,24,24,32"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32,32,0,0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="28">
                    <HorizontalStackLayout Spacing="12">
                        <Label
                            FontFamily="SenRegular"
                            FontSize="14"
                            Text="TOTAL:"
                            TextColor="#A0A5BA"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontFamily="SenRegular"
                            FontSize="30"
                            Text="{Binding TotalAmount, StringFormat='${0:F0}'}"
                            TextColor="#181C2E"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button
                        BackgroundColor="#FF7622"
                        Command="{Binding PayAndConfirmCommand}"
                        CornerRadius="12"
                        FontFamily="SenBold"
                        FontSize="14"
                        HeightRequest="62"
                        IsEnabled="{Binding HasCard}"
                        Text="PAY &amp; CONFIRM"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <ActivityIndicator
                Grid.Row="1"
                HorizontalOptions="Center"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Center"
                Color="#FF7622" />
        </Grid>

        <!--  2. PROCESANDO PAGO  -->
        <Grid
            x:Name="ProcessingState"
            Padding="24"
            BackgroundColor="White"
            IsVisible="{Binding IsProcessing}">

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="20"
                VerticalOptions="Center">

                <skia:SKLottieView
                    HeightRequest="220"
                    HorizontalOptions="Center"
                    RepeatCount="-1"
                    Source="success_wallet.json"
                    WidthRequest="220" />

                <Label
                    FontFamily="SenBold"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    Text="Processing Payment..."
                    TextColor="#181C2E" />

                <Label
                    FontFamily="SenRegular"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    Text="Please wait while we process your payment."
                    TextColor="#A0A5BA" />

            </VerticalStackLayout>
        </Grid>

        <!--  3. PAGO FALLIDO  -->
        <Grid
            x:Name="PaymentFailureState"
            Padding="24"
            BackgroundColor="White"
            IsVisible="{Binding IsPaymentFailed}">

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="20"
                VerticalOptions="Center">

                <Image
                    HeightRequest="220"
                    HorizontalOptions="Center"
                    Source="ic_payment_failed.png"
                    WidthRequest="220" />

                <Label
                    FontFamily="SenBold"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    Text="Payment Failed"
                    TextColor="#181C2E" />

                <Label
                    FontFamily="SenRegular"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ErrorMessage}"
                    TextColor="#A0A5BA" />

                <Button
                    BackgroundColor="#FF7622"
                    Command="{Binding PayAndConfirmCommand}"
                    CornerRadius="14"
                    HeightRequest="56"
                    Text="{Binding PaymentRetryText}"
                    TextColor="White"
                    WidthRequest="260" />

                <Button
                    BackgroundColor="#FF7622"
                    Command="{Binding GoBackCommand}"
                    CornerRadius="14"
                    HeightRequest="56"
                    Text="GO BACK"
                    TextColor="White"
                    WidthRequest="260" />

            </VerticalStackLayout>
        </Grid>

        <syncfusion:SfBottomSheet
            x:Name="CardsBottomSheet"
            Background="White"
            CollapsedHeight="200"
            CornerRadius="24,24,0,0"
            GrabberAreaHeight="28"
            GrabberBackground="#D8E3ED"
            GrabberCornerRadius="60"
            GrabberHeight="7"
            GrabberWidth="70"
            HalfExpandedRatio="0.5"
            IsOpen="{Binding IsBottomSheetOpen, Mode=TwoWay}"
            ShowGrabber="True">
            <!--  CONTENIDO DEL BOTTOM SHEET  -->
            <syncfusion:SfBottomSheet.BottomSheetContent>
                <VerticalStackLayout
                    Padding="24"
                    BackgroundColor="White"
                    Spacing="16">
                    <Label
                        FontFamily="SenBold"
                        FontSize="18"
                        Text="Select Payment Method"
                        TextColor="#181C2E" />

                    <!--  Colección de tarjetas filtradas  -->
                    <CollectionView
                        HeightRequest="250"
                        ItemsSource="{Binding FilteredCards}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:UserPaymentMethod">
                                <Border
                                    Padding="16,12"
                                    BackgroundColor="#F4F5F7"
                                    HeightRequest="62"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewModel.SelectCardCommand, Source={x:Reference PaymentPageRoot}, x:DataType='views:PaymentPage'}" CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                        <Label
                                            Grid.Column="0"
                                            FontFamily="SenBold"
                                            FontSize="15"
                                            Text="{Binding Brand}"
                                            TextColor="#181C2E"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="SenRegular"
                                            FontSize="16"
                                            Text="{Binding CardNumberMasked, StringFormat='•••• {0}'}"
                                            TextColor="#32343E"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontFamily="SenBold"
                                            FontSize="14"
                                            Text="Seleccionar"
                                            TextColor="#FF7622"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </syncfusion:SfBottomSheet.BottomSheetContent>
        </syncfusion:SfBottomSheet>
    </Grid>

</ContentPage>
