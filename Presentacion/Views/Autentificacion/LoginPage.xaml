<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoodApp.Presentacion.Views.Autentificacion.LoginPage"
    x:DataType="vm:LoginViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FoodApp.Presentacion.ViewModels.Autentificacion"
    xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    droid:NavigationBar.Color="White"
    droid:NavigationBar.Style="DarkContent"
    BackgroundColor="#121223"
    Shell.FlyoutBehavior="Disabled">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#121223" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *">

        <!--  Cabecera Oscura con Título  -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,80,24,0"
            HeightRequest="200"
            Spacing="8">
            <Label
                FontFamily="SenBold"
                FontSize="30"
                HorizontalTextAlignment="Center"
                Text="Log In"
                TextColor="White" />

            <Label
                FontFamily="SenRegular"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Text="Please sign in to your existing account"
                TextColor="White" />
        </VerticalStackLayout>

        <!--  Contenedor Blanco Curvado  -->
        <Border
            Grid.Row="1"
            BackgroundColor="White"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Padding="24,24" Spacing="24">

                    <!--  CAMPO EMAIL  -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontFamily="SenBold"
                            FontSize="12"
                            Text="EMAIL"
                            TextColor="#32343E" />

                        <Border
                            Padding="16,0"
                            BackgroundColor="#F0F5FA"
                            HeightRequest="58"
                            Stroke="#F0F5FA"
                            StrokeThickness="1.5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <!--  DataTrigger para cambiar el borde a naranja cuando el Entry tenga el foco  -->
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding x:DataType='Entry', Source={x:Reference EmailEntry}, Path=IsFocused}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="Stroke" Value="#FF7622" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding x:DataType='Entry', Source={x:Reference EmailEntry}, Path=IsFocused}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Stroke" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Entry
                                x:Name="EmailEntry"
                                FontFamily="SenRegular"
                                FontSize="14"
                                Keyboard="Email"
                                Placeholder="example@gmail.com"
                                PlaceholderColor="#A0A5BA"
                                Text="{Binding Email}"
                                TextColor="#32343E"
                                VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>


                    <!--  CAMPO CONTRASEÑA  -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontFamily="SenBold"
                            FontSize="12"
                            Text="PASSWORD"
                            TextColor="#32343E" />

                        <Border
                            Padding="16,0"
                            BackgroundColor="#F0F5FA"
                            HeightRequest="58"
                            Stroke="#F0F5FA"
                            StrokeThickness="1.5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <!--  DataTrigger para cambiar el borde a naranja cuando el PasswordEntry tenga el foco  -->
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding x:DataType='Entry', Source={x:Reference PasswordEntry}, Path=IsFocused}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="Stroke" Value="#FF7622" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding x:DataType='Entry', Source={x:Reference PasswordEntry}, Path=IsFocused}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Stroke" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid ColumnDefinitions="*, Auto">
                                <Entry
                                    x:Name="PasswordEntry"
                                    Grid.Column="0"
                                    FontFamily="SenRegular"
                                    FontSize="14"
                                    IsPassword="{Binding IsPasswordHidden}"
                                    Placeholder="••••••••"
                                    PlaceholderColor="#A0A5BA"
                                    Text="{Binding Password}"
                                    TextColor="#32343E"
                                    VerticalOptions="Center" />

                                <!--  Botón Ojo (Mostrar / Ocultar Contraseña)  -->
                                <ImageButton
                                    Grid.Column="1"
                                    Aspect="Center"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    HeightRequest="16"
                                    HorizontalOptions="End"
                                    Source="{Binding EyeIcon}"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>


                    <!--  REMEMBER ME Y FORGOT PASSWORD  -->
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{Binding RememberMe}"
                            VerticalOptions="Center"
                            Color="#FF7622" />

                        <Label
                            Grid.Column="1"
                            FontFamily="SenRegular"
                            FontSize="13"
                            Text="Remember me"
                            TextColor="#7E8A97"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="2"
                            Padding="6,4"
                            BackgroundColor="Transparent"
                            Command="{Binding ForgotPasswordCommand}"
                            FontFamily="SenRegular"
                            FontSize="14"
                            Text="Forgot Password"
                            TextColor="#FF7622"
                            VerticalOptions="Center" />
                    </Grid>

                    <!--  MENSAJE DE ERROR DINÁMICO EN ROJO  -->
                    <Label
                        FontFamily="SenRegular"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding HasError}"
                        Text="{Binding ErrorMessage}"
                        TextColor="#FF3B30" />
                    <!--  BOTÓN LOG IN  -->
                    <Button
                        Margin="0,10,0,0"
                        BackgroundColor="#FF7622"
                        Command="{Binding LoginCommand}"
                        CornerRadius="12"
                        FontFamily="SenBold"
                        FontSize="14"
                        HeightRequest="62"
                        HorizontalOptions="Fill"
                        Text="LOG IN"
                        TextColor="White" />


                    <!--  REGISTRO SIGN UP  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label
                            FontFamily="SenRegular"
                            FontSize="16"
                            Text="Don’t have an account?"
                            TextColor="#646982"
                            VerticalOptions="Center" />
                        <Button
                            Padding="6,4"
                            BackgroundColor="Transparent"
                            Command="{Binding SignUpCommand}"
                            FontFamily="SenBold"
                            FontSize="14"
                            Text="SIGN UP"
                            TextColor="#FF7622" />
                    </HorizontalStackLayout>


                    <!--  SEPARADOR 'Or'  -->
                    <Label
                        FontFamily="SenRegular"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        Text="Or"
                        TextColor="#646982" />


                    <!--  BOTONES SOCIALES  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">

                        <!--  Facebook  -->
                        <ImageButton
                            IsEnabled="False"
                            CornerRadius="31"
                            HeightRequest="62"
                            HorizontalOptions="Center"
                            Source="ic_facebook.svg"
                            VerticalOptions="Center"
                            WidthRequest="62" />

                        <!--  Twitter / X  -->
                        <ImageButton
                            IsEnabled="False"
                            HeightRequest="62"
                            HorizontalOptions="Center"
                            Source="ic_twitter.svg"
                            VerticalOptions="Center"
                            WidthRequest="62" />

                        <!--  Apple  -->
                        <ImageButton
                            IsEnabled="False"
                            HeightRequest="62"
                            HorizontalOptions="Center"
                            Source="ic_apple.svg"
                            VerticalOptions="Center"
                            WidthRequest="62" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>