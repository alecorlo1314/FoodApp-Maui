<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoodApp.Presentacion.Views.Autentificacion.ForgotPasswordPage"
    x:DataType="vm:ForgotPasswordViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FoodApp.Presentacion.ViewModels.Autentificacion"
    xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    droid:NavigationBar.Color="Transparent"
    droid:NavigationBar.Style="Default"
    BackgroundColor="#121223"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#121223" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *">

        <!--  Cabecera Oscura con Botón Atrás y Textos  -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,24,24,30"
            Spacing="16">

            <!--  Botón Atrás (Circular)  -->
            <ImageButton
                Aspect="Fill"
                Command="{Binding BackCommand}"
                CornerRadius="20"
                HeightRequest="45"
                HorizontalOptions="Start"
                Source="ic_regresar.svg"
                VerticalOptions="Center"
                WidthRequest="45" />

            <!--  Textos Informativos  -->
            <VerticalStackLayout Spacing="8">
                <Label
                    FontFamily="SenBold"
                    FontSize="30"
                    HorizontalTextAlignment="Center"
                    Text="Forgot Password"
                    TextColor="White" />

                <Label
                    FontFamily="SenRegular"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Text="Please sign in to your existing account"
                    TextColor="#FFF2E0" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!--  Contenedor Blanco Curvado  -->
        <Border
            Grid.Row="1"
            BackgroundColor="White"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Padding="24,30" Spacing="24">

                    <!--  CAMPO EMAIL CON FOCUS  -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontFamily="SenBold"
                            FontSize="12"
                            Text="EMAIL"
                            TextColor="#32343E" />

                        <Border
                            Padding="16,0"
                            BackgroundColor="#F0F5FA"
                            HeightRequest="58"
                            Stroke="#F0F5FA"
                            StrokeThickness="1.5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <!--  DataTrigger para cambiar el borde a naranja al enfocar  -->
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding x:DataType='Entry', Source={x:Reference EmailEntry}, Path=IsFocused}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="Stroke" Value="#FF7622" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding x:DataType='Entry', Source={x:Reference EmailEntry}, Path=IsFocused}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Stroke" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Entry
                                x:Name="EmailEntry"
                                FontFamily="SenRegular"
                                FontSize="14"
                                Keyboard="Email"
                                Placeholder="example@gmail.com"
                                PlaceholderColor="#A0A5BA"
                                Text="{Binding Email}"
                                TextColor="#32343E"
                                VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!--  BOTÓN SEND CODE  -->
                    <Button
                        BackgroundColor="#FF7622"
                        Command="{Binding SendCodeCommand}"
                        CornerRadius="12"
                        FontFamily="SenBold"
                        FontSize="14"
                        HeightRequest="62"
                        HorizontalOptions="Fill"
                        Text="SEND CODE"
                        TextColor="White" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>