	  <MauiXaml Update="Presentacion\Views\Usuarios\TrackingOrderPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <None Include=".agents\skills\maui-collectionview\collectionview-api.md" />
	  <None Include=".agents\skills\maui-collectionview\SKILL.md" />
	  <None Include=".agents\skills\maui-data-binding\data-binding-api.md" />
	  <None Include=".agents\skills\maui-data-binding\SKILL.md" />
	  <None Include=".agents\skills\maui-dependency-injection\dependency-injection-api.md" />
	  <None Include=".agents\skills\maui-dependency-injection\SKILL.md" />
	  <None Include=".agents\skills\maui-shell-navigation\shell-navigation-api.md" />
	  <None Include=".agents\skills\maui-shell-navigation\SKILL.md" />
	</ItemGroup>

</Project>
